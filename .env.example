APP_PORT=8080
APP_ENV=development
SESSION_SECRET=replace-with-a-random-secret-before-running
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password

DB_HOST=db
DB_PORT=5432
DB_USER=appuser
DB_PASSWORD=replace-with-a-strong-password
DB_NAME=documentreview
DB_SSLMODE=disable

# Hosted mode: requests containing selected document passages are sent to this API.
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
EMBEDDING_DIMENSIONS=1536

MAX_UPLOAD_BYTES=5242880

# Local Ollama mode:
# 1. Set LLM_PROVIDER=ollama
# 2. Set LLM_BASE_URL=http://ollama:11434
# 3. Set EMBEDDING_MODEL=nomic-embed-text, CHAT_MODEL=llama3.2,
#    and EMBEDDING_DIMENSIONS=768
# 4. Start with: docker compose --profile local-model up --build
# 5. Pull models with:
#    docker compose exec ollama ollama pull nomic-embed-text
#    docker compose exec ollama ollama pull llama3.2
